{
  "name": "hexo-theme-AomeNero",
  "version": "2.1.0",
  "private": true,
  "author": "AomeNero <yotianya@foxmail.com>",
  "homepage": "https://www.aomenero.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AomeNero/blog"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format:pretty": "prettier --write ./{layout,src}/**/*.{pug,scss} && prettier --write ./*.{yml,md}",
    "format:biome": "biome format --write languages scripts source src .",
    "lint": "eslint . --fix",
    "format": "biome format --write languages scripts source src . && prettier --write ./{layout,src}/**/*.{pug,scss} && prettier --write ./*.{yml,md}",
    "watch": "rollup -w -c ./rollup.config.mjs",
    "build": "rollup -c ./rollup.config.mjs",
    "release": "rollup -c ./rollup.config.mjs && node tools/release.cjs"
  },
  "files": [
    "layout",
    "languages",
    "scripts",
    "source",
    "_config.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@prettier/plugin-pug": "^3.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@swc/core": "^1.7.23",
    "eslint": "^9.4.0",
    "fuse.js": "^7.0.0",
    "prettier": "^3.3.1",
    "rollup": "^4.21.2",
    "rollup-plugin-sass": "^1.13.2",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1"
}
