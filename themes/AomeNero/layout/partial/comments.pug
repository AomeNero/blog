- var theme_config = { valine: theme.valine, gitalk: theme.gitalk, giscus: theme.giscus, disqus: theme.disqus, asset_version: asset_version() };
script AomeNero.comment.setConfig(!{ JSON.stringify(theme_config) })

mixin require_comment_scripts
  if theme.valine
    if theme.valine.enable == true
      script(src="//cdn1.lncld.net/static/js/3.0.4/av-min.js")
      script(src="//cdn.jsdelivr.net/gh/xcss/valine@latest/dist/Valine.min.js")

  if theme.gitalk
    if theme.gitalk.enable == true
      link(rel="stylesheet", href=url_for("css/comments/gittalk.css"))
      script(src="https://unpkg.com/gitalk/dist/gitalk.min.js")

  //- giscus 无需预载 SDK:client.js 携带 data-* 挂载到容器自替换为 iframe,由 comment.ts 在换页时重挂

mixin make_comments
  if theme.always_enable_comments || page.comments
    if theme.disqus
      a#comments
      #disqus_thread
      script.
        var disqus_shortname = "#{theme.disqus}";
        var disqus_identifier = "#{page.path}";
        var disqus_title = "#{page.title}";
        var disqus_url = "#{config.url}/#{page.path}";
        (function () {
          var dsq = document.createElement("script");
          dsq.type = "text/javascript";
          dsq.async = true;
          dsq.src = "//" + disqus_shortname + ".disqus.com/embed.js";
          (document.getElementsByTagName("head")[0] || document.getElementsByTagName("body")[0]).appendChild(dsq);
        })();
      script#dsq-count-scr(src="//#{theme.disqus}.disqus.com/count.js", async)

    if theme.valine
      if theme.valine.enable == true
        a#comments
        #vcomments(style="margin: 0 30px")

    if theme.gitalk
      if theme.gitalk.enable == true
        a#comments
        #gitalk_container(style="padding: 10px")

    if theme.giscus
      if theme.giscus.enable == true
        a#comments
        .giscus-container(style="margin: 0 30px")
