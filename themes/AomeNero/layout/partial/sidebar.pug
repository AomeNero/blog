include toc
+make_toc(false)

.sidebar.animated
  .sidebar-top
    .logo-title
      .title
        .logo-avatar
          img(src=url_for(theme.logo_dir), alt="favicon")
        h3(title="")
          a(href="/")= config.title
        if theme.description
          .description
            p!= theme.description
      include social_links

    include toc
    +make_toc(true)

  include footer
